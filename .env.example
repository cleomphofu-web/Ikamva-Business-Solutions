# Backend/worker secrets. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-manager-value
IKAMVA_TENANT_ID=replace-with-tenant-id

# Optional worker runtime settings
IKAMVA_WORKER_ID=worker-production-1
IKAMVA_WORKER_HEALTH_HOST=0.0.0.0
IKAMVA_WORKER_HEALTH_PORT=4190
IKAMVA_WORKER_POLL_INTERVAL_MS=1000
IKAMVA_WORKER_LOCK_TIMEOUT_MINUTES=10

# AI provider (groq by default; use openai when its key is available)
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-secret-manager-value
GROQ_MODEL=openai/gpt-oss-20b

# Optional production email delivery adapter
EMAIL_PROVIDER_URL=https://api.resend.com/emails
EMAIL_PROVIDER_API_KEY=replace-with-secret-manager-value
EMAIL_FROM=Ikamva <noreply@your-verified-domain.example>

# Gmail OAuth (backend only)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4178/api/v1/integrations/gmail/callback
# base64 for exactly 32 random bytes
ENCRYPTION_KEY=replace-with-base64-32-byte-key
